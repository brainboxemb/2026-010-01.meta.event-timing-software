<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="connectivity-layers" name="Connectivity status is layered; local timing is not a RabbitMQ connection state">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="local" value="Local LAN / router&lt;br&gt;independent status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="210" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="internet" value="Internet reachability&lt;br&gt;independent status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rabbit" value="RabbitMQ / backoffice&lt;br&gt;session status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="940" y="210" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="timing" value="SI-01 local timing operation&lt;br&gt;RFID/CAN/in-memory state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="350" y="500" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="Outbox + local reference data&lt;br&gt;allow deferred synchronisation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="uplink available" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="local" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="endpoint reachable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="internet" target="rabbit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="local clients/devices" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="local" target="timing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="committed local data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="timing" target="outbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="sync when connected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="outbox" target="rabbit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
