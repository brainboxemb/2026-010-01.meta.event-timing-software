<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="system-connectivity-status" name="Network connectivity status — separate observations">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="group-paths" value="Possible local network paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#6c8ebf;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="105" width="600" height="590" as="geometry" />
        </mxCell>
        <mxCell id="group-status" value="Connectivity status exposed by the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef8ee;strokeColor=#82b366;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="710" y="105" width="680" height="590" as="geometry" />
        </mxCell>
        <mxCell id="direct-path" value="Direct / development / test IP path&lt;br&gt;loopback • same host • point-to-point&lt;br&gt;no router required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="router-path" value="Optional LAN / Wi-Fi router or AP&lt;br&gt;field deployment path&lt;br&gt;may also provide an external uplink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#777777;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="355" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="local-clients" value="SI-02 • SI-03 • Smart Display V2&lt;br&gt;use the available IP path to reach SI-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="local-ip-status" value="Local IP connectivity&lt;br&gt;SI-01 interface/link and local peer reachability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="router-status" value="Configured router / AP connectivity&lt;br&gt;connected / associated / reachable&lt;br&gt;or N/A when not configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1060" y="170" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="external-status" value="External network reachability&lt;br&gt;outside the local network / Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="backoffice-status" value="Backoffice connectivity&lt;br&gt;endpoint / transport / session health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1060" y="380" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="independence-note" value="These states are not interchangeable:&lt;br&gt;local operation may be healthy while router, external or backoffice connectivity is unavailable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="810" y="545" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="valid local path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=1;dashed=1;" edge="1" parent="1" source="direct-path" target="local-ip-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="when configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0;entryY=0.65;entryDx=0;entryDy=0;entryPerimeter=1;dashed=1;" edge="1" parent="1" source="router-path" target="router-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="possible uplink" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=1;dashed=1;" edge="1" parent="1" source="router-path" target="external-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="peer reachability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=1;dashed=1;" edge="1" parent="1" source="local-clients" target="local-ip-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="distinct from session health" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=1;dashed=1;" edge="1" parent="1" source="external-status" target="backoffice-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
