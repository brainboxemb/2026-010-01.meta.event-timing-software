{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sip-step-board.schema.json",
  "title": "SIP step board",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "title",
    "state",
    "documents",
    "activities"
  ],
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "blocked",
        "complete"
      ]
    },
    "summary": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "uniqueItems": true
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "demonstration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bullets"
      ],
      "properties": {
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        }
      }
    },
    "planning_changes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "change"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "change": {
            "type": "string",
            "minLength": 8,
            "maxLength": 180
          }
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "maturity",
        "completeness"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "enum": [
            "outline",
            "working",
            "review",
            "accepted"
          ]
        },
        "completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "note": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lane",
        "kind",
        "title",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "lane": {
          "type": "string",
          "enum": [
            "tooling",
            "application",
            "verification",
            "platform",
            "documentation"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "decision",
            "setup",
            "implementation",
            "verification",
            "documentation",
            "integration"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "done",
            "next",
            "active",
            "planned",
            "blocked",
            "deferred"
          ]
        },
        "estimate_project_days": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
