<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="rfid-lifecycle" name="RFID reader lifecycle and recovery direction">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="off" value="OFF&lt;br&gt;default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="powering" value="POWERING_ON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="initialising" value="INITIALISING&lt;br&gt;boot + protocol setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="165" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="180" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="poweroff" value="POWERING_OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1100" y="180" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="degraded" value="DEGRADED / UNRESPONSIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="740" y="410" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="error" value="ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="200" height="85" as="geometry" />
        </mxCell>
        <mxCell id="recover" value="RECOVERING / REINITIALISE&lt;br&gt;reconnect -&gt; reset -&gt; power cycle policy TBD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="465" y="625" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="power on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="off" target="powering">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="power available" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="powering" target="initialising">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="initialised" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="initialising" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="power off" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ready" target="poweroff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="power removed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="poweroff" target="off">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="powering" target="error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="initialising" target="error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="heartbeat/protocol loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="ready" target="degraded">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="reinitialise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="degraded" target="recover">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="reinitialise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="error" target="recover">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="recover without power cycle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="recover" target="initialising">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="power cycle/reset path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="recover" target="off">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
