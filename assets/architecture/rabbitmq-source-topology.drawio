<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="rabbitmq-source-topology" name="RabbitMQ connectors behind UpstreamGateway and UpstreamMessageRouter">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1040" math="0" shadow="0">
