          <mxGeometry x="95" y="60" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="broker2" value="RabbitMQ broker B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#777777;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
