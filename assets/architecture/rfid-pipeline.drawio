        <mxCell id="e5" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="decrypt" target="reject">
          <mxGeometry relative="1" as="geometry" />
