        <mxCell id="e4" value="accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="filter" target="resolve">
          <mxGeometry relative="1" as="geometry" />
