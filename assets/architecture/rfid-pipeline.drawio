<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="rfid-pipeline" name="RFID pipeline — raw encrypted reads to accepted registration">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="reader" value="RFID reader callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#777777;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="timestamp" value="Capture observation timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="150" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="decrypt" value="Decrypt + validate tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="150" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="filter" value="Accumulate / filter observations&lt;br&gt;first read is not automatically accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="850" y="135" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="Resolve identity&lt;br&gt;normal tag or reserve-tag mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="135" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Rejected / incomplete observation&lt;br&gt;status/diagnostic only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="610" y="350" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="accepted" value="AcceptedTag&lt;br&gt;with evidence + observation time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="350" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="registration" value="Registration candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="540" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="store" value="RegistrationStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="720" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="Backoffice outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1110" y="720" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="Status / WebSocket update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1400" y="720" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reader" target="timestamp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="timestamp" target="decrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="decrypt" target="filter">
          <mxGeometry relative="1" as="geometry" />
